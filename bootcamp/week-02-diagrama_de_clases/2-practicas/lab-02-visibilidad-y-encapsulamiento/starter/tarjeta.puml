@startuml
' Lab 02 — Visibilidad y encapsulamiento
' Renderiza: plantuml -tsvg starter/tarjeta.puml
title Cine — tarjeta de socio

hide circle
hide empty members
skinparam classAttributeIconSize 0

' Tal como está, cualquiera puede poner points en -500 o cambiar expiresOn a 1990.
class MemberCard {
  + number: String
  + points: Integer
  + expiresOn: Date
  + active: Boolean
  + getPoints(): Integer
  + setPoints(value: Integer): void
  + getExpiresOn(): Date
  + setExpiresOn(value: Date): void
  + validateNumber(): Boolean
}

