@startuml
' Lab 04 — Enumeraciones, clases abstractas e interfaces
' Renderiza: plantuml -tsvg starter/entradas.puml
title Cine — tipos de entrada

hide circle
hide empty members
skinparam classAttributeIconSize 0

class Ticket {
  - seat: String
  - basePrice: Decimal
  + finalPrice(): Decimal
}

class StudentTicket {
  - studentId: String
  + finalPrice(): Decimal
}

class MemberTicket {
  - cardNumber: String
  + finalPrice(): Decimal
}

class Movie {
  - title: String
  - rating: String
}

