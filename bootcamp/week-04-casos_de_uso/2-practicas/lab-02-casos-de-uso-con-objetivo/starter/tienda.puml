@startuml
' Lab 02 — Casos de uso con nivel de objetivo
' Renderiza: plantuml -tsvg starter/tienda.puml
title Tienda — casos de uso del cliente y del encargado

left to right direction

actor Customer
actor "Store Manager" as StoreManager

rectangle "Store System" {
  usecase "Manage store" as A
  usecase "Log in" as B
  usecase "Click buy button" as C
  usecase "Enter card number" as D
  usecase "Product CRUD" as E
  usecase "Save order in database" as F
  usecase "Search product" as G
  usecase "Track order" as H
}

Customer -- B
Customer -- C
Customer -- D
Customer -- G
Customer -- H
StoreManager -- A
StoreManager -- E
StoreManager -- F

