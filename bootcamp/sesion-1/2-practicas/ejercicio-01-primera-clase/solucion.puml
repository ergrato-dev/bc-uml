@startuml
' ============================================================
' Ejercicio 01 — SOLUCIÓN: Mi Primera Clase UML
' ============================================================

skinparam classBackgroundColor #2d2d2d
skinparam classBorderColor #8b5cf6
skinparam classFontColor #e2e8f0
skinparam classAttributeFontColor #94a3b8
skinparam backgroundColor #1a1a1a
skinparam shadowing false

class Producto {
  - id: String
  - nombre: String
  - descripcion: String
  - precio: Double
  - stock: int
  - categoria: String
  - disponible: boolean
  --
  + estaDisponible(): boolean
  + actualizarStock(cambio: int): void
  + getPrecioConDescuento(porcentaje: Double): Double
  - calcularHash(): String
}

@enduml
